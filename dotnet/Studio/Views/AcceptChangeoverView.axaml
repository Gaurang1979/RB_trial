<!-- Supervisor: accept here (CHANGEOVER-VERIFY.md): the product, every batch value and the code in large letters,
     then the second person's name and PIN (or password), Accept and Cancel. A badge on the reader accepts too. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VisionSystem.Studio.ViewModels"
             xmlns:ui="using:VisionSystem.Studio.Controls"
             xmlns:l="using:VisionSystem.Studio.Localization"
             x:Class="VisionSystem.Studio.Views.AcceptChangeoverView"
             x:DataType="vm:AcceptChangeoverViewModel">
  <Border Classes="panel" MinWidth="640" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Title}" Classes="title" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="{Binding ProductLabel}" Classes="muted" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Product}" Name="AcceptProduct" FontSize="{DynamicResource Vs.Font.Title}"
                   FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Values}" Name="AcceptValues" IsVisible="{Binding HasValues}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" FontSize="{DynamicResource Vs.Font.Title}" TextWrapping="Wrap" Margin="0,2" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="{Binding CodeLabel}" Classes="muted" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Code}" Name="AcceptCode" FontSize="{DynamicResource Vs.Font.Counter}"
                   FontWeight="Bold" FontFamily="Consolas,Menlo,monospace" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{Binding CheckText}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding NameLabel}" />
      <TextBox Text="{Binding UserName}" Name="AcceptUser" MinHeight="{DynamicResource Vs.Size.Touch}" />
      <TextBlock Text="{Binding SecretLabel}" />
      <TextBox Text="{Binding Secret}" Name="AcceptSecret" PasswordChar="●" RevealPassword="False"
               MinHeight="{DynamicResource Vs.Size.Touch}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding AcceptCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <TextBlock Text="{Binding CardHint}" Classes="muted" TextWrapping="Wrap" />
      <Border Classes="toned" ui:Ui.Tone="Ng" Padding="{DynamicResource Vs.Pad.S}" CornerRadius="{DynamicResource Vs.Radius.S}"
              IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding Message}" Name="AcceptMessage" TextWrapping="Wrap" />
      </Border>
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Button Grid.Column="0" Classes="vs" Command="{Binding SwitchSecretCommand}" Name="AcceptSwitch" MinWidth="140">
          <TextBlock Text="{Binding SwitchText}" VerticalAlignment="Center" />
        </Button>
        <Button Grid.Column="2" Classes="vs action" Command="{Binding CancelCommand}" Name="AcceptCancel" Margin="0,0,8,0">
          <TextBlock Text="{Binding CancelText}" />
        </Button>
        <Button Grid.Column="3" Classes="vs action primary" Command="{Binding AcceptCommand}" IsEnabled="{Binding !Busy}" Name="AcceptOk">
          <TextBlock Text="{Binding AcceptText}" />
        </Button>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>

<!-- One question with two answers; the safe answer ("No") is on the right of the dangerous one. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VisionSystem.Studio.ViewModels"
             x:Class="VisionSystem.Studio.Views.ConfirmView"
             x:DataType="vm:ConfirmViewModel">
  <Border Classes="panel">
    <StackPanel Spacing="24">
      <TextBlock Text="{Binding Question}" Classes="title" TextWrapping="Wrap" MaxWidth="700" />
      <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
        <Button Classes="vs action" Command="{Binding YesCommand}" Name="ConfirmYes">
          <TextBlock Text="{Binding YesText}" />
        </Button>
        <Button Classes="vs action primary" Command="{Binding NoCommand}" Name="ConfirmNo">
          <TextBlock Text="{Binding NoText}" />
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A security advisory on a package (NuGet audit, all packages since .NET 10) warns but never stops the line build: the monthly dependency watch acts on it (DEP-03). -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <RootNamespace>VisionStudio.Remote</RootNamespace>
    <AssemblyName>RuntimeContract</AssemblyName>
    <Version>1.0.0</Version>
    <Description>The gRPC contract between the runtime service and Vision Studio, the browser dashboard and plant software (proto/visionstudio/remote/v1): generated client and server code, the local endpoint (named pipe or Unix socket), the access rules, and an in-memory stub runtime.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../../proto/visionstudio/remote/v1/runtime.proto" ProtoRoot="../../proto" GrpcServices="Both" />
  </ItemGroup>

</Project>

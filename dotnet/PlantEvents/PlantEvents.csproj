<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A security advisory on a package (NuGet audit, all packages since .NET 10) warns but never stops the line build: the monthly dependency watch acts on it (DEP-03). -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <RootNamespace>PlantEvents</RootNamespace>
    <AssemblyName>PlantEvents</AssemblyName>
    <Version>1.0.0</Version>
    <Description>Plant event schema v1: what a station sends to the plant server (docs/vision-system/PLANT-DASHBOARD-AND-MOBILE.md section 3).</Description>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A security advisory on a package (NuGet audit, all packages since .NET 10) warns but never stops the line build: the monthly dependency watch acts on it (DEP-03). -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <RootNamespace>StationAgent</RootNamespace>
    <AssemblyName>StationAgent</AssemblyName>
    <Version>1.0.0</Version>
    <Description>Sends a station's plant events to the plant server, with a store-and-forward queue on disk so the line never waits for the server.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PlantEvents/PlantEvents.csproj" />
  </ItemGroup>

</Project>

    // what the engineer typed into a GS1 field that did not parse, and why: shown until corrected, so a
    // rejected entry never looks applied
    private readonly Dictionary<(CodeToolConfig, string), string> Gs1Typed = new();
    private readonly Dictionary<(CodeToolConfig, string), string> Gs1Errors = new();

    private void SetGs1Ais(CodeToolConfig code, Gs1Rules g, string? text)
    {
        try
        {
            g.Required = CodeTeach.ParseAis(text ?? "");
            Gs1Typed.Remove((code, "ais"));
            Gs1Errors.Remove((code, "ais"));
        }
        catch (FormatException e)
        {
            Gs1Typed[(code, "ais")] = text ?? "";
            Gs1Errors[(code, "ais")] = e.Message;
        }
    }

    private void SetGs1Values(CodeToolConfig code, string? text)
    {
        try
        {
            code.Gs1Values = CodeTeach.ParseAiValues(text ?? "");
            Gs1Typed.Remove((code, "values"));
            Gs1Errors.Remove((code, "values"));
        }
        catch (FormatException e)
        {
            Gs1Typed[(code, "values")] = text ?? "";
            Gs1Errors[(code, "values")] = e.Message;
        }
    }

    /// <summary>Find codes of any type in the region (or whole image) and lock the tool to them (CodeTeach.Lock).</summary>
    private void AutoFindCode()
    {
        if (Image is null || Selected is not CodeToolConfig code) return;
        // every type and every code in the area (count 0: the reader does not stop at the first)
        var probe = new CodeToolConfig { Name = code.Name, Format = CodeFormat.Any, ExpectedCount = 0, Roi = code.Roi, TimeBudgetMs = 1500 };
        using var tool = new CodeTool(probe, Models, teaching: true);
        var r = tool.Run(Image, new BatchFields());
        var mine = CodeTeach.Lock(code, tool.LastCodes);
        if (mine.Count == 0) { Say(T["teach.no_code"], true); return; }
        var shown = r.Graphics.Where(g => mine.Any(c => c.Text == g.Label)).ToList();
        var pts = shown.SelectMany(g => g.Points).ToList();
        if (pts.Count > 0) code.Roi = Pad(pts, 0.25);
        Say(T.Format("teach.found_code", CodeFormats.Name(code.Format), mine.Count == 1 ? mine[0].Text : T.Format("teach.codes_read", mine.Count)));
        Redraw(shown);
    }

    private static readonly Lazy<IReadOnlyList<string>> SystemFonts = new(FontRender.Families);

    // a font taught from print and one drawn from a system font are not mixed: changing where it comes from clears it
    private void SetFontFrom(TextToolConfig text, string? from)
    {
        bool system = from == "system";
        if (system == text.Rendered is not null) return;
        text.Rendered = system ? new RenderedFont { SizePx = text.CharHeightPx } : null;
        text.Font = "";
        FontCells = null;
    }

    /// <summary>Draws the system font's characters and teaches them (also done when the job is saved).</summary>
    private void DrawFont(TextToolConfig text)
    {
        if (FontRender.Prepare(text) is { } problem) Say(T.Format("text.font_refused", problem), true);
        else Say(T.Format("text.render_drawn", TextTool.FontGlyphs(text.Font)));
    }

    private void ClearFont()
    {
        if (Selected is not TextToolConfig text) return;
        text.Font = "";
        FontCells = null;
        Say(T["text.font_cleared"]);
    }

    // the font's read of the line to teach, one cell per character: a sure one shows what was read, an
    // unsure one starts empty for the engineer to type; any cell can be changed (a new character can read
    // as a taught one with confidence, as an 8 for a B)
    private sealed class FontCell
    {
        public required string Read { get; init; }
        public required bool Sure { get; init; }
        public string Typed { get; set; } = "";
    }
    private List<FontCell>? FontCells;
    private TextToolConfig? FontCellsTool;
    private readonly Dictionary<int, string> CharTyped = new();

    private OcrEngine FontEngine(TextToolConfig text)
    {
        var settings = text.ToSettings();
        settings.Reader = OcrReader.Font;
        settings.TimeBudgetMs = 1000;   // teaching runs once
        var eng = new OcrEngine(settings);
        try { if (!string.IsNullOrEmpty(text.Font)) eng.SetFont(text.Font); }
        catch { eng.Dispose(); throw; }
        return eng;
    }

    /// <summary>Reads line FontLine with the font taught so far and asks only about the characters it is unsure of.</summary>
    private void ReadFontLine()
    {
        if (Image is null || Selected is not TextToolConfig text || string.IsNullOrEmpty(text.Font)) return;
        try
        {
            using var eng = FontEngine(text);
            eng.SetExpected(Array.Empty<string>());
            var r = eng.Run(Image.Pixels, Image.Width, Image.Height, Image.Stride);
            if (FontLine < 1 || FontLine > r.Lines.Count || r.Lines[FontLine - 1].Chars.Count == 0)
            {
                Say(T.Format("text.font_no_line", FontLine, r.Lines.Count), true);
                FontCells = null;
                return;
            }
            FontCells = FontTeach.Asks(r.Lines[FontLine - 1]).Select(a => new FontCell { Read = a.Read, Sure = a.Sure, Typed = a.Sure ? a.Read : "" }).ToList();
            FontCellsTool = text;
            int unsure = FontCells.Count(c => !c.Sure);
            Say(unsure == 0 ? T["text.font_all_sure"] : T.Format("text.font_ask", unsure));
        }
        catch (InvalidOperationException e) { Say(T.Format("text.font_refused", e.Message), true); }
    }

    private void TeachAsked()
    {
        if (FontCells is null) return;
        if (FontTeach.Compose(FontCells.Select(c => (string?)c.Typed).ToList(), out int bad) is not { } line)
        {
            Say(T.Format("text.font_type_cell", bad + 1), true);
            return;
        }
        if (TeachFont(line)) FontCells = null;
    }

    /// <summary>"Teach this character": one character of the tried picture, without teaching its line again.</summary>
    private void TeachOneChar(FontTeach.Candidate cand, int k)
    {
        if (Image is null || Selected is not TextToolConfig text) return;
        var typed = CharTyped.GetValueOrDefault(k)?.Trim() ?? "";
        if (FontTeach.Compose(new[] { typed }, out _) is null) { Say(T["text.font_type_char"], true); return; }
        try
        {
            using var eng = FontEngine(text);
            eng.TeachChar(Image.Pixels, Image.Width, Image.Height, Image.Stride, cand.At, typed);
            text.Font = eng.GetFont();
            CharTyped.Clear();
            Try();   // the list shows what is still not OK
            Say(T.Format("text.font_char_taught", typed, eng.FontGlyphs));
        }
        catch (InvalidOperationException e) { Say(T.Format("text.font_refused", e.Message), true); }
    }

    /// <summary>Teaches the taught-font reader the characters printed on one line of this image; false when refused.</summary>
    private bool TeachFont(string lineText)
    {
        if (Image is null || Selected is not TextToolConfig text) return false;
        if (string.IsNullOrWhiteSpace(lineText)) { Say(T["text.font_type_text"], true); return false; }
        try
        {
            using var eng = FontEngine(text);
            int n = eng.TeachFont(Image.Pixels, Image.Width, Image.Height, Image.Stride, FontLine - 1, lineText);
            text.Font = eng.GetFont();
            Say(T.Format("text.font_taught", n, eng.FontGlyphs));
            FontText = "";
            return true;
        }
        catch (InvalidOperationException e)
        {
            Say(T.Format("text.font_refused", e.Message), true);
            return false;
        }
    }

    /// <summary>Read the text in the region, size the tool to it and fill the lines (time printed -> {TIME}).</summary>
    private void AutoFindText()
    {
        if (Image is null || Selected is not TextToolConfig text) return;
        bool font = text.Reader == OcrReader.Font;
        if (font && string.IsNullOrWhiteSpace(text.Font)) { Say(T["text.font_first"], true); return; }
        if (!font && !File.Exists(Models.OcrNet)) { Say(T["teach.no_ocr_model"], true); return; }
        List<OcrLine> lines;
        try { lines = TextTeach.Read(Image, text, Models); }
        catch (InvalidOperationException e)
        {
            Say(T.Format("text.font_refused", e.Message), true);
            return;
        }
        if (lines.Count == 0) { Say(T["teach.no_text"], true); return; }
        // keep the lines that sit together with the best-read one (a block), not stray label print
        lines = TextTeach.MainBlock(lines);
        TextTeach.Fill(text, lines, Image);
        Say(T.Format("teach.found_text", lines.Count));
        Redraw(lines.Select(l => new Graphic(l.Corners, GraphicKind.Info, l.Text)));
    }

    /// <summary>Why a format line does not compile; empty when it does.</summary>
    private static string FormatError(string template, List<string> monthLanguages)
    {
        if (string.IsNullOrWhiteSpace(template)) return "";
        try { TextFormat.Parse(template, monthLanguages); return ""; }
        catch (FormatException e) { return e.Message; }
    }

    private RoiBox Pad(List<VisionCore.PointF> pts, double frac) => AutoFind.Pad(pts, frac, Image!.Width, Image.Height);

    private void Try()
    {
        if (Image is null) return;
        try
        {
            Draft.Validate();
            using var runner = new JobRunner(Draft, Models);
            var batch = S.Job?.Name == Draft.Name ? S.Batch : new BatchFields();
            TryResult = runner.Run(Cam, Image, batch);
            Say(TryResult.Pass ? "✓ OK" : "✗ " + TryResult.FirstProblem, !TryResult.Pass);
            Redraw(TryResult.Tools.SelectMany(t => t.Graphics));
        }
        catch (Exception e) { Say(e.Message, true); }
    }

    private void Save()
    {
        // a GS1 field with an entry that did not parse: the job is not saved with the old rules
        if (Gs1Errors.FirstOrDefault(kv => Draft.Tools.Contains(kv.Key.Item1)) is { Key.Item1: { } tool, Value: { } why })
        {
            Say($"{tool.Name}: {why}", true);
            return;
        }
        try
        {
            Jobs.Save(Draft, "teach");
            if (S.Job?.Name == Draft.Name) S.Reload();
            Say(T.Format("teach.saved", Draft.Name, Draft.Version));
        }
        catch (Exception e) { Say(e.Message, true); }
    }

    public void Dispose() => Images.Remove(Key);

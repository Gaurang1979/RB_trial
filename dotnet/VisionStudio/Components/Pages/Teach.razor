    private void AddPhase()
    {
        var ph = new PhaseToolConfig
        {
            Name = NextName(T["tool.phase"]),
            Camera = Cam,
            EstimateRotation = true,
            EstimateScale = false,
            MinCorrelationScore = 0.15f,
            MinPsr = 7.0f,

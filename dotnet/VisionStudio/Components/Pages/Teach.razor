@page "/teach"
@page "/teach/{JobName}"
@attribute [Authorize(Roles = "Engineer")]
@implements IDisposable
@inject JobStore Jobs
@inject ModelPaths Models
@inject ImageCache Images
@inject CameraDrivers Drivers
@inject Station S
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<StudioOptions> Studio
@using BarcodeReading

<PageTitle>@T["teach.title"]</PageTitle>

<div class="runbar">
    <input class="big" placeholder="@T["teach.job_name"]" @bind="Draft.Name" />
    <input class="big num" type="number" min="0" max="999" title="@T["teach.job_number"]" placeholder="@T["teach.job_number"]" @bind="Draft.Number" />
    <button class="big primary" @onclick="Save">✓ @T["common.save"]</button>
    <button class="big" @onclick="Try" disabled="@(Image is null)">▶ @T["teach.try"]</button>
    <div class="spacer"></div>
    @if (Message is not null) { <span class="@(MessageBad ? "bad" : "good")">@Message</span> }
</div>

<div class="tabs">
    @for (int i = 0; i < Draft.Cameras.Count; i++)
    {
        int k = i;
        <button class="tab @(Cam == k ? "on" : "")" @onclick="() => SelectCamera(k)">📷 @Draft.Cameras[k].Name</button>
    }
    @if (Draft.Cameras.Count < Job.MaxCameras)
    {
        <button class="tab" @onclick="AddCamera">+ @T["teach.add_camera"]</button>
    }
</div>

<div class="teach">
    <div class="canvasbox">
        @if (Frame is not null)
        {
            <div class="canvas" style="width:@(Frame.Width)px;height:@(Frame.Height)px">
                <img src="img/@(Key).jpg?v=@Version" width="@Frame.Width" height="@Frame.Height" draggable="false" />
                @if (Drag is { } d)
                {
                    <div class="drag" style="left:@(Math.Min(d.X0, d.X1))px;top:@(Math.Min(d.Y0, d.Y1))px;width:@(Math.Abs(d.X1 - d.X0))px;height:@(Math.Abs(d.Y1 - d.Y0))px"></div>
                }
                @if (Selected?.Roi is { } r)
                {
                    <div class="sel" style="left:@(r.X * Frame.Scale)px;top:@(r.Y * Frame.Scale)px;width:@(r.Width * Frame.Scale)px;height:@(r.Height * Frame.Scale)px"></div>
                }
                <div class="capture" @onpointerdown="Down" @onpointermove="Move" @onpointerup="Up" @onpointerleave="Up"></div>
            </div>
            <p class="muted">@Image?.Name  ·  @Image?.Width × @Image?.Height  ·  @T["teach.draw_hint"]</p>
        }
        else
        {
            <div class="noimg">@T["teach.no_image"]</div>
        }
        <div class="row">
            <button @onclick="Grab">📷 @T["teach.grab"]</button>
            <input class="wide" placeholder="@T["teach.image_path"]" @bind="ImagePath" @bind:event="oninput" />
            <button @onclick="LoadPath">@T["teach.load"]</button>
            <button @onclick="() => Step(-1)">◀</button>
            <button @onclick="() => Step(1)">▶</button>
        </div>
        @if (TryResult is not null)
        {
            <table class="tools">
                @foreach (var t in TryResult.Tools)
                {
                    <tr class="@ToolNotice.Row(t)"><td>@ToolNotice.Mark(t)</td><td>@t.ToolName</td><td>@t.Summary</td><td class="num">@t.TimeMs.ToString("0") ms</td></tr>
                    @foreach (var d in t.Details) { <tr class="sub"><td></td><td colspan="3">@d</td></tr> }
                }
            </table>
        }
    </div>

    <div class="panel">
        <h3>@T["teach.camera"]</h3>
        <div class="form">
            <label><span>@T["teach.camera_name"]</span><input @bind="CamCfg.Name" /></label>
            <label><span>@T["teach.camera_unit"]</span>
                <select @bind="CamCfg.Serial">
                    <option value="">@T["teach.camera_first"]</option>
                    @foreach (var c in CameraList) { <option value="@c.Serial">@c.Label (@c.Serial)</option> }
                    @if (!string.IsNullOrEmpty(CamCfg.Serial) && CameraList.All(c => c.Serial != CamCfg.Serial)) { <option value="@CamCfg.Serial">@CamCfg.Serial</option> }
                </select>
                <button @onclick="ListCameras">↻</button>
            </label>
            <label><span>@T["teach.exposure"]</span><input type="number" @bind="CamCfg.ExposureUs" /></label>
            <label><span>@T["teach.gain"]</span><input type="number" step="0.5" @bind="CamCfg.GainDb" /></label>
            <label><span>@T["teach.test_folder"]</span><input class="wide" @bind="CamCfg.TestFolder" /></label>
        </div>

        <h3>@T["teach.toolbox"]</h3>
        <div class="row">
            <button class="tool" @onclick="AddLocate">⌖ @T["tool.locate"]</button>
            <button class="tool" @onclick="AddCode">▥ @T["tool.code"]</button>
            <button class="tool" @onclick="() => AddText(TextMode.Read)">Aa @T["tool.read_text"]</button>
            <button class="tool" @onclick="() => AddText(TextMode.Check)">A✓ @T["tool.check_text"]</button>
            <button class="tool" @onclick="AddMeasure">📏 @T["tool.measure"]</button>
            <button class="tool" @onclick="AddBlob">◌ @T["tool.blob"]</button>
            <button class="tool" @onclick="AddInspect">🔍 @T["tool.inspect"]</button>
            <button class="tool" @onclick="AddAnomaly">🔴 @T["tool.anomaly"]</button>
            <button class="tool" @onclick="AddThermal">♨ @T["tool.thermal"]</button>
            <button class="tool" @onclick="AddInfrared">🔬 @T["tool.infrared"]</button>
            <button class="tool" @onclick="AddPolar">👓 @T["tool.polar"]</button>
            <button class="tool" @onclick="AddPhotometric">🔦 @T["tool.photometric"]</button>
            <button class="tool" @onclick="AddWavelet">〰 @T["tool.wavelet"]</button>
            <button class="tool" @onclick="AddInpaint">🖌 @T["tool.inpaint"]</button>
            <button class="tool" @onclick="AddRectify">📐 @T["tool.rectify"]</button>
            <button class="tool" @onclick="AddDrift">🧭 @T["tool.drift"]</button>
            <button class="tool" @onclick="AddDeform">🥨 @T["tool.deform"]</button>
            <button class="tool" @onclick="AddPhase">🎯 @T["tool.phase"]</button>
            <button class="tool" @onclick="AddMetamorphic">🧪 @T["tool.metamorphic"]</button>
            <button class="tool" @onclick="AddAutotune">🩺 @T["tool.autotune"]</button>
        </div>

        <h3>@T["teach.tools"]</h3>
        @foreach (var t in Draft.Tools.Where(t => t.Camera == Cam))
        {
            <div class="toolrow @(t == Selected ? "on" : "")" @onclick="() => Select(t)">
                <span>@(t switch { LocateToolConfig => "⌖", CodeToolConfig => "▥", MeasureToolConfig => "📏", BlobToolConfig => "◌", InspectToolConfig => "🔍", AnomalyToolConfig => "🔴", ThermalToolConfig => "♨", InfraredToolConfig => "🔬", PolarToolConfig => "👓", PhotometricToolConfig => "🔦", WaveletToolConfig => "〰", InpaintToolConfig => "🖌", RectifyToolConfig => "📐", DriftToolConfig => "🧭", DeformToolConfig => "🥨", PhaseToolConfig => "🎯", MetamorphicToolConfig => "🧪", AutotuneToolConfig => "🩺", _ => "Aa" }) @t.Name</span>
                <span class="muted">@(t.Roi is { } r ? $"{r.Width}×{r.Height}" : T["teach.whole_image"])</span>
                @if (ToolNotice.Of(t) == TextTool.ReportOnlyExplain)
                {
                    <span class="muted" title="@T[TextTool.ReportOnlyExplain]">ⓘ @T["text.report_only_tag"]</span>
                }
                else if (ToolNotice.Of(t) == TextTool.NoRuleExplain)
                {
                    <span class="bad" title="@T[TextTool.NoRuleExplain]">⚠ @T["text.no_rule_tag"]</span>
                }
                <button class="link" @onclick="() => Remove(t)" @onclick:stopPropagation>✕</button>
            </div>
        }

        @if (Selected is not null)
        {
            <h3>@Selected.Name</h3>
            <div class="form">
                <label><span>@T["teach.tool_name"]</span><input @bind="Selected.Name" /></label>
                <label><span>@T["teach.region"]</span>
                    <span>@(Selected.Roi is { } rr ? $"{rr.X}, {rr.Y}  {rr.Width}×{rr.Height}" : T["teach.whole_image"])</span>
                    <button @onclick="() => { Selected.Roi = null; Redraw(); }">@T["teach.whole_image"]</button>
                </label>
                @if (Selected is LocateToolConfig loc)
                {
                    <p class="muted">@T["locate.hint"]</p>
                    @if (loc.Quality is { } q)
                    {
                        <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid var(--line); border-radius: 8px; padding: 10px; margin: 8px 0;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                <span style="font-size: 12px; font-weight: 700; color: var(--muted);">SHAPE MODEL QUALITY</span>
                                <span style="font-size: 11px; font-weight: 800; padding: 2px 8px; border-radius: 4px; background: @(q.IsSufficient ? "var(--ok-bg)" : "var(--ng-bg)"); color: @(q.IsSufficient ? "var(--ok)" : "var(--ng)");">
                                    @q.Rating (@q.Score.ToString("0.0")%)
                                </span>
                            </div>
                            <div style="font-size: 11px; font-family: ui-monospace, monospace; color: var(--muted); display: flex; gap: 12px;">
                                <span>Edges: <strong>@q.EdgeCount</strong></span>
                                <span>Entropy: <strong>@q.OrientationEntropy.ToString("0.00")</strong></span>
                                <span>Contrast: <strong>@q.ContrastStdDev.ToString("0.0")</strong></span>
                            </div>
                            @if (q.Warnings.Length > 0)
                            {
                                <div style="margin-top: 6px; font-size: 11px; color: var(--warn); display: flex; flex-direction: column; gap: 2px;">
                                    @foreach (var w in q.Warnings)
                                    {
                                        <span>⚠️ @w</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    <label><span>@T["locate.max_angle"]</span><input type="number" @bind="loc.MaxAngleDeg" /></label>
                    <label><span>@T["locate.min_score"]</span><input type="number" step="0.05" @bind="loc.MinScore" /></label>
                    <label><span>Polarity Metric</span>
                        <select @bind="loc.Metric">
                            <option value="@LocateMetric.UsePolarity">Standard (Use Polarity)</option>
                            <option value="@LocateMetric.IgnoreGlobalPolarity">Ignore Global Inversion (White/Black)</option>
                            <option value="@LocateMetric.IgnoreLocalPolarity">Ignore Local Polarity (Specular/Foil)</option>
                        </select>
                    </label>
                    <label><span>Search Mode</span>
                        <select @bind="loc.SearchMode">
                            <option value="@LocateSearchMode.EdgeGeometric">Edge Geometric (PatMax-style)</option>
                            <option value="@LocateSearchMode.Correlation">Normalized Correlation</option>
                        </select>
                    </label>
                    <label><span>@T["locate.search"]</span>
                        <span>@(loc.SearchArea is { } sa ? $"{sa.X}, {sa.Y}  {sa.Width}×{sa.Height}" : T["teach.whole_image"])</span>
                    </label>
                    <label><span>@T["locate.pattern"]</span>
                        <span>@(loc.Pattern is not null ? $"{loc.PatternWidth}×{loc.PatternHeight}" : T["locate.not_taught"])</span>
                    </label>
                    <button @onclick="TeachPattern">✨ @T["teach.auto_find"]</button>
                }
                @if (Selected is MeasureToolConfig measure)
                {
                    <p class="muted">@T["measure.hint"]</p>
                    <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid var(--line); border-radius: 8px; padding: 10px; margin: 8px 0;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                            <span style="font-size: 12px; font-weight: 700; color: var(--muted);">CALIPER FEATURES (@measure.Features.Count)</span>
                            <button type="button" class="button" style="padding: 2px 8px; font-size: 11px; min-height: 28px;" @onclick="AddMeasureCaliper">+ Add Caliper</button>
                        </div>
                        @foreach (var f in measure.Features)
                        {
                            <div style="padding: 6px; background: rgba(0,0,0,0.3); border-radius: 6px; margin-bottom: 4px; font-size: 12px;">
                                <div style="display: flex; justify-content: space-between;">
                                    <strong>@f.Name (@f.GetType().Name.Replace("Feature", ""))</strong>
                                    <span class="muted">Threshold: @(f.Threshold == 0 ? "Auto" : f.Threshold.ToString("0"))</span>
                                </div>
                                @if (f is CaliperFeature cf)
                                {
                                    <div style="display: flex; gap: 8px; font-size: 11px; color: var(--muted); margin-top: 3px;">
                                        <span>Mode: @cf.Mode</span>
                                        <span>Polarity: @cf.Polarity</span>
                                        <span>Box: @cf.Box.Length×@cf.Box.Height px</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid var(--line); border-radius: 8px; padding: 10px; margin: 8px 0;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                            <span style="font-size: 12px; font-weight: 700; color: var(--muted);">TOLERANCE CHECKS (@measure.Checks.Count)</span>
                            <button type="button" class="button" style="padding: 2px 8px; font-size: 11px; min-height: 28px;" @onclick="AddMeasureCheck">+ Add Check</button>
                        </div>
                        @foreach (var ch in measure.Checks)
                        {
                            <div style="padding: 6px; background: rgba(0,0,0,0.3); border-radius: 6px; margin-bottom: 4px; font-size: 12px;">
                                <div style="display: flex; justify-content: space-between;">
                                    <strong>@ch.Name (@ch.Value on @ch.Feature)</strong>
                                    <span style="color: var(--cyan); font-family: ui-monospace, monospace;">@(ch.Min?.ToString("0.0") ?? "–") .. @(ch.Max?.ToString("0.0") ?? "–") @ch.Unit</span>
                                </div>
                                <div style="display: flex; gap: 6px; align-items: center; margin-top: 4px;">
                                    <span class="muted small">Min:</span>
                                    <input type="number" step="0.1" style="width: 80px; min-height: 32px; padding: 2px 6px;" @bind="ch.Min" />
                                    <span class="muted small">Max:</span>
                                    <input type="number" step="0.1" style="width: 80px; min-height: 32px; padding: 2px 6px;" @bind="ch.Max" />
                                </div>
                            </div>
                        }
                    </div>
                }
                @if (Selected is BlobToolConfig blob)
                {
                    <p class="muted">@T["blob.hint"]</p>
                    <label><span>Min Area (px)</span><input type="number" @bind="blob.MinArea" /></label>
                    <label><span>Max Area (px)</span><input type="number" @bind="blob.MaxArea" /></label>
                    <label><span>Blob Polarity</span>
                        <select @bind="blob.Polarity">
                            <option value="@BlobPolarity.LightOnDark">Bright on dark</option>
                            <option value="@BlobPolarity.DarkOnLight">Dark on bright</option>
                        </select>
                    </label>
                    <label><span>Threshold Mode</span>
                        <select @bind="blob.Threshold">
                            <option value="@BlobThreshold.Auto">Automatic (Otsu)</option>
                            <option value="@BlobThreshold.Fixed">Fixed Level</option>
                        </select>
                    </label>
                    @if (blob.Threshold == BlobThreshold.Fixed)
                    {
                        <label><span>Fixed Threshold</span><input type="number" min="0" max="255" @bind="blob.Level" /></label>
                    }
                    <label><span>Count Tolerance</span>
                        <span style="display: flex; gap: 6px; align-items: center;">
                            <input type="number" style="width: 80px;" placeholder="Min" @bind="blob.MinCount" />
                            <span>..</span>
                            <input type="number" style="width: 80px;" placeholder="Max" @bind="blob.MaxCount" />
                        </span>
                    </label>
                }
                @if (Selected is InspectToolConfig ins)
                {
                    <p class="muted">@T["inspect.hint"]</p>
                    <label><span>Sensitivity (k·σ)</span><input type="number" step="0.1" min="0.1" max="5.0" @bind="ins.Sensitivity" /></label>
                    <label><span>Base Offset (grey)</span><input type="number" step="1" min="1" max="50" @bind="ins.BaseOffset" /></label>
                    <label><span>Edge Tolerance (px)</span><input type="number" step="0.5" min="0" max="10" @bind="ins.EdgeTolerancePx" /></label>
                    <label><span>Min Defect Area (px)</span><input type="number" min="1" max="1000" @bind="ins.MinDefectAreaPx" /></label>
                    <label class="check">
                        <input type="checkbox" @bind="ins.NormalizeLighting" />
                        <span>Normalize Lighting Drift</span>
                    </label>
                }
                @if (Selected is AnomalyToolConfig anom)
                {
                    <p class="muted">@T["anomaly.hint"]</p>
                    <label><span>Sensitivity</span><input type="number" step="0.1" min="0.5" max="2.0" @bind="anom.Sensitivity" /></label>
                    <label><span>Patch Size (px)</span><input type="number" step="2" min="8" max="64" @bind="anom.PatchSize" /></label>
                    <label><span>Min Defect Area (px)</span><input type="number" min="5" max="1000" @bind="anom.MinDefectAreaPx" /></label>
                }
                @if (Selected is ThermalToolConfig therm)
                {
                    <p class="muted">@T["thermal.hint"]</p>
                    <label><span>@T["thermal.mode"]</span>
                        <select @bind="therm.Mode">
                            <option value="@ThermalInspectionMode.BottleInductionSeal">@T["thermal.bottle"]</option>
                            <option value="@ThermalInspectionMode.PouchHeatSeal">@T["thermal.pouch"]</option>
                            <option value="@ThermalInspectionMode.HotMeltGlue">@T["thermal.glue"]</option>
                            <option value="@ThermalInspectionMode.BlisterPocket">@T["thermal.blister"]</option>
                        </select>
                    </label>
                    <div class="row">
                        <label><span>T Min (°C)</span><input type="number" step="1" @bind="therm.TMinCalib" /></label>
                        <label><span>T Max (°C)</span><input type="number" step="1" @bind="therm.TMaxCalib" /></label>
                    </div>

                    @if (therm.Mode == ThermalInspectionMode.BottleInductionSeal)
                    {
                        <div class="row">
                            <label><span>Inner Radius (px)</span><input type="number" min="5" @bind="therm.BottleInnerRadiusPx" /></label>
                            <label><span>Outer Radius (px)</span><input type="number" min="10" @bind="therm.BottleOuterRadiusPx" /></label>
                        </div>
                        <div class="row">
                            <label><span>Min Seal Temp (°C)</span><input type="number" step="1" @bind="therm.BottleMinSealTempC" /></label>
                            <label><span>Max Seal Temp (°C)</span><input type="number" step="1" @bind="therm.BottleMaxSealTempC" /></label>
                        </div>
                        <div class="row">
                            <label><span>Max Cold Gap (°)</span><input type="number" step="1" min="0" max="180" @bind="therm.BottleMaxColdGapDeg" /></label>
                            <label><span>Missing Foil (°C)</span><input type="number" step="1" @bind="therm.BottleMissingFoilTempC" /></label>
                        </div>
                    }
                    else if (therm.Mode == ThermalInspectionMode.PouchHeatSeal)
                    {
                        <div class="row">
                            <label><span>Min Seal Temp (°C)</span><input type="number" step="1" @bind="therm.PouchMinSealTempC" /></label>
                            <label><span>Min Width (px)</span><input type="number" step="1" min="1" @bind="therm.PouchMinSealWidthPx" /></label>
                        </div>
                        <div class="row">
                            <label><span>Max Void Length (px)</span><input type="number" step="1" min="0" @bind="therm.PouchMaxVoidLengthPx" /></label>
                            <label><span>Contam Drop (°C)</span><input type="number" step="1" @bind="therm.PouchContaminationDropC" /></label>
                        </div>
                        <label class="check">
                            <input type="checkbox" @bind="therm.PouchIsVertical" />
                            <span>Vertical Seam</span>
                        </label>
                    }
                    else if (therm.Mode == ThermalInspectionMode.HotMeltGlue)
                    {
                        <div class="row">
                            <label><span>Expected Beads</span><input type="number" min="1" max="16" @bind="therm.GlueExpectedBeads" /></label>
                            <label><span>Min Glue Temp (°C)</span><input type="number" step="1" @bind="therm.GlueMinTempC" /></label>
                        </div>
                        <div class="row">
                            <label><span>Min Bead Length (px)</span><input type="number" step="1" @bind="therm.GlueMinBeadLengthPx" /></label>
                            <label><span>Max Bead Gap (px)</span><input type="number" step="1" @bind="therm.GlueMaxBeadGapPx" /></label>
                        </div>
                        <label class="check">
                            <input type="checkbox" @bind="therm.GlueIsVertical" />
                            <span>Vertical Dispense</span>
                        </label>
                    }
                    else if (therm.Mode == ThermalInspectionMode.BlisterPocket)
                    {
                        <div class="row">
                            <label><span>Rows</span><input type="number" min="1" max="10" @bind="therm.BlisterRows" /></label>
                            <label><span>Cols</span><input type="number" min="1" max="20" @bind="therm.BlisterCols" /></label>
                        </div>
                        <div class="row">
                            <label><span>Min Barrier Width (px)</span><input type="number" step="1" min="1" @bind="therm.BlisterMinBarrierWidthPx" /></label>
                            <label><span>Min Seal Temp (°C)</span><input type="number" step="1" @bind="therm.BlisterMinSealTempC" /></label>
                        </div>
                    }
                }
                @if (Selected is InfraredToolConfig ir)
                {
                    <p class="muted">@T["infrared.hint"]</p>
                    <label><span>@T["infrared.mode"]</span>
                        <select @bind="ir.Mode">
                            <option value="@InfraredInspectionMode.FillLevel">@T["infrared.fill_level"]</option>
                            <option value="@InfraredInspectionMode.MetamericInk">@T["infrared.metameric"]</option>
                            <option value="@InfraredInspectionMode.MoistureBarrier">@T["infrared.moisture"]</option>
                            <option value="@InfraredInspectionMode.CrackDetection">@T["infrared.cracks"]</option>
                        </select>
                    </label>

                    @if (ir.Mode == InfraredInspectionMode.FillLevel)
                    {
                        <div class="row">
                            <label><span>Pixels / mm</span><input type="number" step="0.1" min="0.1" @bind="ir.PxPerMm" /></label>
                            <label><span>Target Fill (mm)</span><input type="number" step="0.5" @bind="ir.TargetFillMm" /></label>
                        </div>
                        <div class="row">
                            <label><span>Underfill Tol (mm)</span><input type="number" step="0.1" min="0.1" @bind="ir.TolUnderfillMm" /></label>
                            <label><span>Overfill Tol (mm)</span><input type="number" step="0.1" min="0.1" @bind="ir.TolOverfillMm" /></label>
                        </div>
                        <div class="row">
                            <label><span>Min Contrast</span><input type="number" step="1" min="1" @bind="ir.MinMeniscusContrast" /></label>
                            <label class="check">
                                <input type="checkbox" @bind="ir.IgnoreFoam" />
                                <span>Ignore Foam</span>
                            </label>
                        </div>
                    }
                    else if (ir.Mode == InfraredInspectionMode.MetamericInk)
                    {
                        <div class="row">
                            <label><span>Dye NDMI Thresh</span><input type="number" step="0.05" @bind="ir.DyeNdmiThresh" /></label>
                            <label><span>Carbon NDMI Max</span><input type="number" step="0.05" @bind="ir.CarbonNdmiMax" /></label>
                        </div>

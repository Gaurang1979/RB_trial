                            <option value="@PrintType.Solid">@T["text.print_solid"]</option>
                            <option value="@PrintType.DotMatrix">@T["text.print_dot"]</option>
                        </select>
                    </label>
                    <label><span>@T["text.char_height"]</span><input type="number" @bind="text.CharHeightPx" /></label>
                    <label><span>@T["text.min_quality"]</span><input type="number" @bind="text.MinQuality" /></label>
                    <label><span>@T["text.reader"]</span>
                        <select @bind="text.Reader">
                            <option value="@OcrReader.Ai">@T["text.reader_ai"]</option>
                            <option value="@OcrReader.Font">@T["text.reader_font"]</option>
                        </select>
                    </label>
                    @if (text.Reader == OcrReader.Font)
                    {
                        <label><span>@T["text.font_from"]</span>
                            <select value="@(text.Rendered is null ? "print" : "system")" @onchange="e => SetFontFrom(text, (string?)e.Value)">
                                <option value="print">@T["text.font_from_print"]</option>
                                <option value="system">@T["text.font_from_system"]</option>
                            </select>
                        </label>
                        @if (text.Rendered is { } rf)
                        {
                            <p class="muted">@T["text.render_hint"]</p>
                            <label><span>@T["text.render_family"]</span>
                                <select @bind="rf.Family">
                                    <option value=""></option>
                                    @foreach (var f in SystemFonts.Value) { <option value="@f">@f</option> }
                                </select>
                            </label>
                            <label><span>@T["text.render_size"]</span><input type="number" min="@FontRender.MinSizePx" max="@FontRender.MaxSizePx" @bind="rf.SizePx" /></label>
                            <label><span>@T["text.render_bold"]</span><input type="checkbox" @bind="rf.Bold" /></label>
                            <label><span>@T["text.render_chars"]</span><input class="wide" @bind="rf.Characters" /></label>
                            <button @onclick="() => DrawFont(text)">@T["text.render_draw"]</button>
                        }
                        else
                        {
                        <p class="muted">@T.Format("text.font_hint", TextTool.FontGlyphs(text.Font))</p>
                        <div class="line">
                            <span>@T["text.font_line"]</span>
                            <input type="number" min="1" max="32" @bind="FontLine" />
                            <input class="wide" @bind="FontText" placeholder="LOT A12345" />
                            <button @onclick="() => TeachFont(FontText)">@T["text.font_teach"]</button>
                            <button class="link" @onclick="ClearFont">@T["text.font_clear"]</button>
                        </div>
                        @if (!string.IsNullOrEmpty(text.Font))
                        {
                            <button @onclick="ReadFontLine">@T["text.font_read"]</button>
                        }
                        @if (FontCells is { } cells && FontCellsTool == text)
                        {
                            <p class="muted">@T["text.font_ask_hint"]</p>
                            <div class="line">
                                @for (int i = 0; i < cells.Count; i++)
                                {
                                    int k = i;
                                    <input class="char @(cells[k].Sure ? "" : "unsure")" size="1" maxlength="2" title="@(cells[k].Sure ? "" : T.Format("text.font_read_as", cells[k].Read))"
                                           value="@cells[k].Typed" @onchange="e => cells[k].Typed = e.Value?.ToString() ?? string.Empty" />
                                }
                                <button @onclick="TeachAsked">@T["text.font_teach"]</button>
                            </div>
                        }
                        @if (TryResult?.Tools.FirstOrDefault(r => r.ToolName == text.Name)?.Lines is { } ran && FontTeach.Candidates(ran) is { Count: > 0 } toTeach)
                        {
                            <p class="muted">@T["text.font_char_hint"]</p>
                            @for (int i = 0; i < toTeach.Count; i++)
                            {
                                var cand = toTeach[i];
                                int k = i;
                                <div class="line">
                                    <span>@T.Format("text.font_char_at", cand.Line + 1, cand.Char.Found.Length > 0 ? cand.Char.Found : "?")</span>
                                    @if (cand.Char.Status == CharStatus.Unknown) { <span class="muted">@T["text.font_not_taught"]</span> }
                                    @if (cand.Should.Length > 0) { <span class="muted">@T.Format("text.font_char_should", cand.Should)</span> }
                                    <input class="char" size="1" maxlength="2" value="@CharTyped.GetValueOrDefault(k)" @onchange="e => CharTyped[k] = e.Value?.ToString() ?? string.Empty" />
                                    <button @onclick="() => TeachOneChar(cand, k)">@T["text.font_teach_char"]</button>
                                </div>
                            }
                        }
                        }
                    }
                    <button @onclick="AutoFindText">✨ @T["teach.auto_find"]</button>
                    @if (text.Mode == TextMode.Check)
                    {
                        <p class="muted">@T["text.lines_hint"]</p>
                        @for (int i = 0; i < text.Lines.Count; i++)
                        {
                            var line = text.Lines[i];
                            int k = i;
                            <div class="line">
                                <span>@(k + 1)</span>
                                <select @bind="line.Entry">
                                    <option value="@LineEntry.Template">@T["text.template"]</option>
                                    <option value="@LineEntry.FullText">@T["text.full_text"]</option>
                                </select>
                                <input class="wide" @bind="line.Template" placeholder="@(line.Entry == LineEntry.Template ? "₹ {MRP}, {BATCH}" : "")" />
                                <button class="link" @onclick="() => text.Lines.RemoveAt(k)">✕</button>
                            </div>
                        }
                        <button @onclick="() => text.Lines.Add(new TextLineSpec())">+ @T["text.add_line"]</button>
                    }
                    else
                    {
                        <label><span>@T["text.report_only"]</span><input type="checkbox" @bind="text.ReportOnly" /></label>
                        @if (ToolNotice.Of(text) is { } notice)
                        {
                            <p class="@(notice == TextTool.NoRuleExplain ? "bad" : "muted")">@(notice == TextTool.NoRuleExplain ? "⚠" : "ⓘ") @T[notice]</p>
                        }
                        <p class="muted">@T["text.formats_hint"]</p>
                        @for (int i = 0; i < text.Lines.Count; i++)
                        {
                            var line = text.Lines[i];
                            int k = i;
                            <div class="line">
                                <span>@(k + 1)</span>
                                <input class="wide" @bind="line.Template" placeholder="LOT {A:1}{D:5}" />
                                <span class="muted">@FormatError(line.Template, text.MonthLanguages)</span>
                                <button class="link" @onclick="() => text.Lines.RemoveAt(k)">✕</button>
                            </div>
                        }
                        @if (TextTool.SetupProblem(text) is { } problem)
                        {
                            <p class="muted">⚠ @problem</p>
                        }
                        <button @onclick="() => text.Lines.Add(new TextLineSpec { Entry = LineEntry.Format })">+ @T["text.add_format"]</button>
                        <div class="line">
                            <span>@T["text.month_languages"]</span>
                            @foreach (var lang in TextFormat.MonthNames.Keys)
                            {
                                var monthLang = lang;
                                <label title="@string.Join(" ", TextFormat.MonthNames[monthLang].Select(m => m[0]))">
                                    <input type="checkbox" checked="@MonthLanguages.Has(text, monthLang)" @onchange="e => MonthLanguages.Set(text, monthLang, e.Value is true)" />
                                    @MonthLanguages.Name(monthLang)
                                </label>
                            }
                        </div>
                        <label><span>@T["text.expiry_months"]</span><input type="number" min="0" max="240" @bind="text.Dates.ExpiryMonths" /></label>
                        <label><span>@T["text.mfd_within_days"]</span><input type="number" min="0" max="366" @bind="text.Dates.MfdWithinDays" /></label>
                    }
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? JobName { get; set; }
    /// <summary>An NG image from the Run page's list (its path under ng-images, NgTeachLink): loaded with its job and camera.</summary>
    [SupplyParameterFromQuery(Name = "ng")] public string? Ng { get; set; }
    private string? _ngLoaded;

    private Job Draft = new() { Name = "" };
    private int Cam;
    private CameraConfig CamCfg => Draft.Cameras[Cam];
    private ToolConfig? Selected;
    private readonly Dictionary<int, GrayImage> TeachImages = new();
    private GrayImage? Image => TeachImages.TryGetValue(Cam, out var i) ? i : null;
    private Render.Frame? Frame;
    private int Version;
    private readonly string Key = "teach-" + Guid.NewGuid().ToString("N")[..8];
    private string? ImagePath;
    private int FontLine = 1;
    private string FontText = "";
    private string? Message;
    private bool MessageBad;
    private JobResult? TryResult;
    private IReadOnlyList<CameraInfo> CameraList = Array.Empty<CameraInfo>();
    private record DragBox(double X0, double Y0, double X1, double Y1);
    private DragBox? Drag;

    protected override void OnParametersSet()
    {
        if (Ng is not null && JobName is null)
        {
            if (Ng != _ngLoaded) LoadNgImage(Ng);
            return;
        }
        Job? j = null;
        try { if (JobName is not null) j = Jobs.LoadForEdit(JobName); }
        catch (JobLoadException e) { Say(e.Message, true); }
        if (j is not null)
        {
            if (j.LoadProblems.Count > 0) Say(string.Join("; ", j.LoadProblems), true);
            Draft = JobStore.Clone(j);
            for (int i = 0; i < Draft.Cameras.Count; i++)
                if (Draft.Cameras[i].ReferenceImage is { } p && File.Exists(p))
                    TeachImages[i] = GrayImage.Load(p);
        }
        Redraw();
    }

    /// <summary>The picture of an NG image link, in the job and on the camera that saved it; a new job when that job is gone.</summary>
    private void LoadNgImage(string rel)
    {
        _ngLoaded = rel;
        var path = NgTeachLink.Resolve(Path.Combine(Studio.Value.DataFolder, "ng-images"), rel);
        if (path is null) { Say(T["teach.ng_missing"], true); Redraw(); return; }
        var owner = NgTeachLink.Owner(NgTeachLink.Label(path), Jobs.Names().Select(n => Jobs.TryLoad(n, forEdit: true)).OfType<Job>());
        if (owner is { } o)
        {
            Draft = JobStore.Clone(o.Job);
            for (int i = 0; i < Draft.Cameras.Count; i++)
                if (Draft.Cameras[i].ReferenceImage is { } p && File.Exists(p))
                    TeachImages[i] = GrayImage.Load(p);
            Cam = o.Camera;
        }
        try
        {
            SetImage(GrayImage.Load(path), path);
            Say(owner is null ? T["teach.ng_no_job"] : T.Format("teach.ng_loaded", Draft.Name, CamCfg.Name), owner is null);
        }
        catch (Exception e) { Say(e.Message, true); }
    }

    private void Say(string m, bool bad = false) { Message = m; MessageBad = bad; }

    private void SelectCamera(int i) { Cam = i; Selected = null; TryResult = null; Redraw(); }

    private void AddCamera()
    {
        Draft.Cameras.Add(new CameraConfig { Name = $"Camera {Draft.Cameras.Count + 1}" });
        SelectCamera(Draft.Cameras.Count - 1);
    }

    private void ListCameras()
    {
        CameraList = Drivers.List();
        Say(CameraList.Count == 0 ? T["teach.no_cameras"] : T.Format("teach.cameras_found", CameraList.Count), CameraList.Count == 0);
    }

    private void Grab()
    {
        try
        {
            using var c = Drivers.Open(CamCfg);
            var img = c.Grab(3000) ?? throw new InvalidOperationException(T["teach.no_frame"]);
            var folder = Path.Combine(AppContext.BaseDirectory, "data", "teach");
            Directory.CreateDirectory(folder);
            // the image naming pattern (owner, 2026-10-31), with the day's grab count as its serial
            var path = Path.Combine(folder, S.GrabName(Draft.Number, Cam) + ".bmp");
            BarcodeReading.BmpImage.SaveGray(path, img.Pixels, img.Width, img.Height);
            SetImage(GrayImage.Load(path), path);
        }
        catch (Exception e) { Say(e.Message, true); }
    }

    private void LoadPath()
    {
        var p = ImagePath?.Trim().Trim('"');
        if (string.IsNullOrEmpty(p)) return;
        try
        {
            if (Directory.Exists(p))
            {
                CamCfg.TestFolder = p;
                var files = FolderSource.List(p);
                if (files.Count == 0) { Say(T["teach.no_bmp"], true); return; }
                p = files[0];
            }
            SetImage(GrayImage.Load(p), p);
        }
        catch (Exception e) { Say(e.Message, true); }
    }

    private void Step(int d)
    {
        var folder = CamCfg.TestFolder ?? (Image is null ? null : Path.GetDirectoryName(CamCfg.ReferenceImage));
        if (folder is null) return;
        var files = FolderSource.List(folder).ToList();
        if (files.Count == 0) return;
        int at = Math.Max(0, files.IndexOf(CamCfg.ReferenceImage ?? ""));
        var p = files[((at + d) % files.Count + files.Count) % files.Count];
        SetImage(GrayImage.Load(p), p);
    }

    private void SetImage(GrayImage img, string path)
    {
        TeachImages[Cam] = img;
        CamCfg.ReferenceImage = path;
        ImagePath = path;
        TryResult = null;
        FontCells = null;
        Redraw();
    }

    private void Redraw(IEnumerable<Graphic>? graphics = null)
    {
        if (Image is null) { Frame = null; return; }
        // 760 px wide: the teach screen fits a 1366 x 768 panel PC beside the tool panel
        Frame = Render.Draw(Image, graphics, Draft.Tools.Where(t => t.Camera == Cam && t.Roi is not null && t != Selected).Select(t => t.Roi!), 760);
        Images.Put(Key, Frame);
        Version++;
    }

    // ---- region drawing (pointer: mouse or touch)
    private void Down(PointerEventArgs e) { if (Selected is not null) Drag = new(e.OffsetX, e.OffsetY, e.OffsetX, e.OffsetY); }
    private void Move(PointerEventArgs e) { if (Drag is { } d) Drag = d with { X1 = e.OffsetX, Y1 = e.OffsetY }; }
    private void Up(PointerEventArgs e)
    {
        if (Drag is not { } d || Selected is null || Frame is null) { Drag = null; return; }
        Drag = null;
        double x0 = Math.Min(d.X0, d.X1), y0 = Math.Min(d.Y0, d.Y1), w = Math.Abs(d.X1 - d.X0), h = Math.Abs(d.Y1 - d.Y0);
        if (w < 8 || h < 8) return;
        Selected.Roi = new RoiBox((int)(x0 / Frame.Scale), (int)(y0 / Frame.Scale), (int)(w / Frame.Scale), (int)(h / Frame.Scale));
        Redraw();
    }

    // ---- tools
    private string NextName(string stem)
    {
        for (int i = 1; ; i++)
            if (Draft.Tools.All(t => !t.Name.Equals($"{stem} {i}", StringComparison.OrdinalIgnoreCase))) return $"{stem} {i}";
    }

    private void AddLocate()
    {
        if (Draft.Tools.Any(t => t is LocateToolConfig && t.Camera == Cam)) { Say(T["locate.one_per_camera"], true); return; }
        Selected = new LocateToolConfig { Name = NextName(T["tool.locate"]), Camera = Cam };
        Draft.Tools.Insert(0, Selected);    // runs first: the other tools follow it
        Say(T["locate.draw_now"]);
        Redraw();
    }

    /// <summary>Takes the marked area as the pattern and checks it is found again in this picture.</summary>
    private void TeachPattern()
    {
        if (Image is null || Selected is not LocateToolConfig loc) return;
        try
        {
            loc.Teach(Image);
            using var tool = new LocateTool(loc);
            var (r, _) = tool.Find(Image);
            Say(T.Format("locate.taught", loc.PatternWidth, loc.PatternHeight, r.TimeMs.ToString("0")), !r.Pass);
            Redraw(r.Graphics);
        }
        catch (Exception e) { Say(e.Message, true); }
    }

    /// <summary>Takes the marked area of this picture (a good part) as the tool's reference (requirements 17.10 AUD-01).</summary>
    private void TeachReference(ITaughtReference tool, Action<GrayImage> teach)
    {
        if (Image is null) return;
        try
        {
            teach(Image);
            Say(T.Format("reference.taught", tool.ReferenceWidth, tool.ReferenceHeight));
            Redraw();
        }
        catch (Exception e) { Say(e.Message, true); }
    }

    /// <summary>Teaches the drift baseline from this picture and the good-part pictures in the camera's test folder.</summary>
    private void TeachDriftBaseline(DriftToolConfig drift)
    {
        if (Image is null) return;
        try
        {
            var more = CamCfg.TestFolder is { } f ? FolderSource.List(f).Take(49).Select(GrayImage.Load) : Enumerable.Empty<GrayImage>();
            int n = drift.Teach(more.Prepend(Image));
            Say(T.Format("drift.baseline_taught", n));
        }
        catch (Exception e) { Say(e.Message, true); }
    }

    private void AddCode()
    {
        Selected = new CodeToolConfig { Name = NextName(T["tool.code"]), Camera = Cam };
        Draft.Tools.Add(Selected);
        Say(T["teach.draw_now"]);
        Redraw();
    }

    private void AddText(TextMode mode)
    {
        Selected = new TextToolConfig { Name = NextName(mode == TextMode.Read ? T["tool.read_text"] : T["tool.check_text"]), Camera = Cam, Mode = mode };
        Draft.Tools.Add(Selected);
        Say(T["teach.draw_now"]);
        Redraw();
    }

    private void AddMeasure()
    {
        var m = new MeasureToolConfig { Name = NextName(T["tool.measure"]), Camera = Cam };
        m.Features.Add(new CaliperFeature
        {
            Name = "Width 1",
            Mode = CaliperMode.Pair,
            Polarity = EdgePolarity.DarkToLight,
            Box = new RotBox(100, 100, 60, 20, 0)
        });
        m.Checks.Add(new MeasureCheck
        {
            Name = "Width",
            Value = MeasureValue.Width,
            Feature = "Width 1",
            Unit = MeasureUnit.Px
        });
        Selected = m;
        Draft.Tools.Add(Selected);
        Say(T["teach.draw_now"]);
        Redraw();
    }

    private void AddMeasureCaliper()
    {
        if (Selected is not MeasureToolConfig measure) return;
        int idx = measure.Features.Count + 1;
        measure.Features.Add(new CaliperFeature
        {
            Name = $"Caliper {idx}",
            Mode = CaliperMode.Single,
            Polarity = EdgePolarity.DarkToLight,
            Box = new RotBox(100 + idx * 10, 100 + idx * 10, 50, 20, 0)
        });
        Say($"Added Caliper {idx}");
        Redraw();
    }

    private void AddMeasureCheck()
    {
        if (Selected is not MeasureToolConfig measure) return;
        var firstFeature = measure.Features.FirstOrDefault()?.Name ?? "Feature 1";
        int idx = measure.Checks.Count + 1;
        measure.Checks.Add(new MeasureCheck
        {
            Name = $"Check {idx}",
            Value = MeasureValue.Width,
            Feature = firstFeature,
            Unit = MeasureUnit.Px
        });
        Say($"Added Check {idx}");
        Redraw();
    }

    private void AddBlob()

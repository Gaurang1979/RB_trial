@using System.Globalization
@* A half-circle gauge for 0 to 100 percent; the colour and the shape (✓ ! ✗) show the level. *@
<svg class="vc-gauge @_css" viewBox="0 0 100 64" role="img" aria-label="@_aria" @attributes="Extra">
    <title>@_aria</title>
    <path class="vc-gauge-track" d="M 10 52 A 40 40 0 0 1 90 52" pathLength="100" />
    @if (_has) { <path class="vc-gauge-val" d="M 10 52 A 40 40 0 0 1 90 52" pathLength="100" stroke-dasharray="@_dash 100" /> }
    <text class="vc-gauge-num" x="50" y="46" text-anchor="middle">@_text</text>
    @if (_symbol.Length > 0) { <g><text class="vc-gauge-sym" x="50" y="62" text-anchor="middle">@_symbol</text></g> }
</svg>

@code {
    /// <summary>0 to 100; empty, NaN or infinity shows "–".</summary>
    [Parameter] public double? Percent { get; set; }
    [Parameter] public ChartLevel Level { get; set; }
    /// <summary>What the gauge shows, for screen readers and the tooltip.</summary>
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public int Decimals { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Extra { get; set; }

    private double? _p;
    private ChartLevel _lvl = (ChartLevel)(-1);
    private string? _label;
    private int _dec = -1;
    private bool _dirty = true, _has;
    private string _text = "–", _aria = "", _dash = "0", _css = "", _symbol = "";

    protected override void OnParametersSet()
    {
        if (_p == Percent && _lvl == Level && _label == Label && _dec == Decimals && !_dirty) return;
        (_p, _lvl, _label, _dec) = (Percent, Level, Label, Decimals);
        _dirty = true;
        _has = ChartNum.Good(Percent);
        var p = _has ? Math.Clamp(Percent!.Value, 0, 100) : 0;
        _text = _has ? p.ToString("F" + Decimals) + "%" : "–";
        _dash = p.ToString("0.##", CultureInfo.InvariantCulture);
        _css = _has ? ChartNum.Css(Level) : "vc-none";
        _symbol = _has ? ChartNum.Symbol(Level) : "";
        _aria = $"{Label}: {_text}";
    }

    protected override bool ShouldRender()
    {
        var d = _dirty;
        _dirty = false;
        return d;
    }
}

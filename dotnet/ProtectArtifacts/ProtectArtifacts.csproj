<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>vs-protect</AssemblyName>
    <RootNamespace>VisionTools.ProtectArtifacts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reuses BarcodeReading.Protection.ContentCipher so the container format is identical to the runtime's. -->
    <ProjectReference Include="../CodeReader/CodeReader.csproj" />
  </ItemGroup>

</Project>

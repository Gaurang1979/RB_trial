<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hikrobot camera adapter. Builds against the SDK developer files in
    third_party/hikrobot-mvs-sdk; override with -p:MvsSdkDir=<path> to use another SDK
    version. Line PCs still need MVS (or the Hikrobot SDK runtime package) installed for
    the camera driver.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>BarcodeReading.Hik</RootNamespace>
    <AssemblyName>BarcodeReading.HikCamera</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <MvsSdkDir Condition="'$(MvsSdkDir)' == ''">$(MSBuildThisFileDirectory)../../third_party/hikrobot-mvs-sdk</MvsSdkDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CodeReader/CodeReader.csproj" />
    <ProjectReference Include="../StationGuard/StationGuard.csproj" />
    <Reference Include="MvCameraControl.Net">
      <HintPath>$(MvsSdkDir)\DotNet\win64\netstandard2.0\MvCameraControl.Net.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>

@page "/trends"
@attribute [Authorize]
@rendermode InteractiveServer
@inject CaseLog Log
@inject ProductStore Store

<PageTitle>Trends</PageTitle>

<h1>Trends</h1>

<section class="panel controls">
    <label>
        Product
        <select @bind="product" @bind:after="Load">
            <option value="">all products</option>
            @foreach (var p in products)
            {
                <option value="@p.ProductCode">@p.ProductCode</option>
            }
        </select>
    </label>
    <label>
        Period
        <select @bind="hours" @bind:after="Load">
            <option value="8">last 8 hours</option>
            <option value="24">last 24 hours</option>
            <option value="168">last 7 days</option>
        </select>
    </label>
</section>

<section class="panel">
    <TrendChart Rows="rows" />
    @if (rows.Count > 0)
    {
        long exp = rows.Sum(r => r.Expected), read = rows.Sum(r => r.Read);
        <p>
            @rows.Sum(r => r.Cases) cases, @rows.Sum(r => r.Complete) complete;
            @read of @exp expected codes read (@((exp > 0 ? (double)read / exp : 1).ToString("P2"))).
        </p>
    }
</section>

<section class="panel">
    <h2>Recent cases</h2>
    <table>
        <thead><tr><th>Case</th><th>Time</th><th>Product</th><th>Read</th><th>Time</th><th>Label</th><th>Parent</th></tr></thead>
        <tbody>
            @foreach (var c in recent)
            {
                <tr class="@(c.Complete ? "" : "badrow")">
                    <td>@c.Id</td><td>@c.TimeUtc.ToLocalTime().ToString("dd MMM HH:mm:ss")</td><td>@c.Product</td>
                    <td>@c.Read / @c.Expected</td><td>@c.TotalMs.ToString("F0") ms</td><td>@c.LabelBrightness.ToString("F0")</td>
                    <td>@(c.ParentCode?.Replace("\u001D", "<GS>") ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
</section>

@code {
    private IReadOnlyList<ProductMaster> products = Array.Empty<ProductMaster>();
    private IReadOnlyList<TrendRow> rows = Array.Empty<TrendRow>();
    private IReadOnlyList<CaseRow> recent = Array.Empty<CaseRow>();
    private string product = "";
    private int hours = 24;

    protected override void OnInitialized()
    {
        products = Store.List();
        Load();
    }

    private void Load()
    {
        string? p = string.IsNullOrEmpty(product) ? null : product;
        rows = Log.Trend(p, DateTime.UtcNow.AddHours(-hours));
        recent = Log.Recent(50, p);
    }
}

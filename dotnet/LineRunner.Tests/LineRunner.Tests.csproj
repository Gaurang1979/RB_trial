<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A security advisory on a package (NuGet audit, all packages since .NET 10) warns but never stops the line build: the monthly dependency watch acts on it (DEP-03). -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <!-- LineRunner itself is an x64 program (Hikrobot SDK): its grading class is compiled in here, so the
       tests also run on an arm64 development Mac. -->
  <ItemGroup>
    <Compile Include="../LineRunner/CaseGrading.cs" Link="CaseGrading.cs" />
    <ProjectReference Include="../VisionCore/VisionCore.csproj" />
    <ProjectReference Include="../PlantEvents/PlantEvents.csproj" />
  </ItemGroup>

</Project>

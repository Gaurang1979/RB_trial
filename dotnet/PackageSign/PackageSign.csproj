<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PackageSign</RootNamespace>
    <AssemblyName>PackageSign</AssemblyName>
    <Version>0.1.0</Version>
    <Description>Builds and signs the package integrity manifest, and verifies it (build-time tool; not shipped on the line).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisionCore\VisionCore.csproj" />
  </ItemGroup>

</Project>

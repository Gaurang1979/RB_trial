<Project Sdk="Microsoft.NET.Sdk">
  <!-- Soak helper for vs-runtime (tools/soak/README.md): writes the soak job, runs its tools on a
       folder for reference verdicts, and starts, stops and watches the runtime over its contract. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>soakctl</AssemblyName>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../dotnet/RuntimeContract/RuntimeContract.csproj" />
    <ProjectReference Include="../../../dotnet/VisionCore/VisionCore.csproj" />
  </ItemGroup>
</Project>

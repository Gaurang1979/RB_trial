{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && nohup scripts/coord.sh cleanup >>\"$(git rev-parse --git-common-dir)/coord-cleanup.log\" 2>&1 </dev/null &"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && nohup scripts/coord.sh cleanup --include-current >>\"$(git rev-parse --git-common-dir)/coord-cleanup.log\" 2>&1 </dev/null &"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/merge-guard.sh"
          }
        ]
      }
    ]
  }
}

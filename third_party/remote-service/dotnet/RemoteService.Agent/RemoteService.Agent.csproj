<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Sundaram.RemoteService</RootNamespace>
    <PackageId>Sundaram.RemoteService.Agent</PackageId>
    <Version>0.1.0</Version>
    <Description>Remote service agent: outbound link to the support relay, Service-code sessions, audited file transfer, actions, data views.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <EmbeddedResource Include="Ui/*" LogicalName="Sundaram.RemoteService.Ui.%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="RemoteService.Agent.Tests" />
  </ItemGroup>

</Project>
